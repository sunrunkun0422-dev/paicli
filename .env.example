# PaiCLI Python 配置。至少填写一个 provider API Key。

# 可选：固定默认 provider。未设置时按下方 Key 顺序自动检测。
# PAICLI_PROVIDER=glm

GLM_API_KEY=your_api_key_here
# GLM_MODEL=glm-5.1
# GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# DEEPSEEK_API_KEY=your_api_key_here
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# STEP_API_KEY=your_api_key_here
# STEP_MODEL=step-3.5-flash
# STEP_BASE_URL=https://api.stepfun.com/v1

# KIMI_API_KEY=your_api_key_here
# KIMI_MODEL=kimi-k2.6
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# FREELLMAPI_API_KEY=your_api_key_here
# FREELLMAPI_MODEL=auto
# FREELLMAPI_BASE_URL=http://localhost:5173/v1

# XFYUN_MAAS_API_KEY=your_api_key_here
# XFYUN_MAAS_MODEL=服务控制台中的 modelId
# XFYUN_MAAS_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
# XFYUN_MAAS_LORA_ID=可选的resourceId

# AGNES_API_KEY=your_api_key_here
# AGNES_MODEL=agnes-2.0-flash
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# suggest（默认）/ auto / never；CLI --yes / --never-approve 会覆盖。
# PAICLI_APPROVAL_MODE=suggest
# PAICLI_COMMAND_TIMEOUT_SECONDS=60
